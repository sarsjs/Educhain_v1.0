rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - control de acceso según rol
    // Los usuarios pueden leer su propio perfil para verificación de rol
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
          (resource.data.role == 'estudiante' || resource.data.role == 'alumno')
        ) ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor' &&
          (resource.data.role == 'estudiante' || resource.data.role == 'alumno')
        )
      );

      // Directores pueden gestionar todos los perfiles; orientadores solo pueden crear/editar/borrar alumnos.
      allow write: if request.auth != null &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
            (
              (request.resource != null && (request.resource.data.role == 'estudiante' || request.resource.data.role == 'alumno')) ||
              (request.resource == null && resource != null && (resource.data.role == 'estudiante' || resource.data.role == 'alumno'))
            )
          ) ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor' &&
            resource.data.role in ['estudiante', 'alumno'] &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['badges'])
          )
        );
    }

    // Groups collection - read allowed for all roles, write only for directors
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';
    }

    // Subjects collection - read for all roles, write only for directors
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';
    }

    // Timetables collection - read allowed for all, write only for directors
    match /timetables/{timetableId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';
    }

    // Messages collection - read allowed for authenticated users, write restricted
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                   (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');
    }

    // Chat messages (1:1)
    match /chat_messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /badge_suggestions/{suggestionId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin']);
    }

    // Events collection - read for all roles, write restricted to directors and counselors
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                   (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador');
      allow delete: if request.auth != null &&
                    (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador');
    }

    // Attendance collection - read/write based on role
    // To handle the document ID format {studentId}_{date}_{subjectId}, we need to implement
    // role-based access and allow students to access their own records
    match /attendance/{attendanceId} {
      allow read: if request.auth != null &&
                  (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' ||
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');
      allow write: if request.auth != null &&
                   (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');
    }

    // Grades collection - read/write based on role
    match /grades/{gradeId} {
      allow read: if request.auth != null &&
                  (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' ||
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');
      allow write: if request.auth != null &&
                   (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');
    }

    // Activity Logs collection
    match /activity_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
                  (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador');
    }

    // Default rule - restrictive for all other collections
    match /{document=**} {
      allow read, write: if false; // Default: no access
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - control de acceso según rol
    // Los usuarios pueden leer su propio perfil para verificación de rol
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
          (resource.data.role == 'estudiante' || resource.data.role == 'alumno' || resource.data.role == 'profesor' || resource.data.role == 'orientador')
        ) ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor' &&
          (resource.data.role == 'estudiante' || resource.data.role == 'alumno')
        )
      );

      // Directores pueden gestionar todos los perfiles; orientadores solo pueden crear/editar/borrar alumnos.
      allow write: if request.auth != null &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
            (
              (request.resource != null && (request.resource.data.role == 'estudiante' || request.resource.data.role == 'alumno')) ||
              (request.resource == null && resource != null && (resource.data.role == 'estudiante' || resource.data.role == 'alumno'))
            )
          ) ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
            resource.data.role == 'profesor' &&
            request.resource.data.role == 'profesor'
          ) ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor' &&
            resource.data.role in ['estudiante', 'alumno'] &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['badges'])
          )
        );
    }

    // Groups: director sees/manages all; orientador manages only groups in their scope.
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
          request.resource.data.counselorId == request.auth.uid
        )
      );
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
          resource.data.counselorId == request.auth.uid &&
          request.resource.data.counselorId == request.auth.uid
        )
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
          resource.data.counselorId == request.auth.uid
        )
      );
    }

    // Subjects are a school-wide catalog. New relationships to teachers/groups
    // live in academic_assignments, not in this catalog.
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'orientador'];
    }

    // Teacher-subject-group relationship.
    match /academic_assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.counselorId == request.auth.uid
        )
      ) &&
      exists(/databases/$(database)/documents/users/$(request.resource.data.teacherId)) &&
      get(/databases/$(database)/documents/users/$(request.resource.data.teacherId)).data.role == 'profesor' &&
      exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId));
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
          get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.counselorId == request.auth.uid &&
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.counselorId == request.auth.uid
        )
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
        (
          get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.counselorId == request.auth.uid
        )
      );
    }

    // Timetables: director has full control; orientador may manage schedules
    // only for groups assigned to them (titular or temporary coverage).
    match /timetables/{timetableId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director'
        ) ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
          exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)) &&
          (
            get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.counselorId == request.auth.uid ||
            get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.tempCounselorId == request.auth.uid
          )
        )
      ) &&
      request.resource.data.teacherId is string &&
      exists(/databases/$(database)/documents/academic_assignments/$(request.resource.data.groupId + '_' + request.resource.data.subjectId + '_' + request.resource.data.teacherId)) &&
      get(/databases/$(database)/documents/academic_assignments/$(request.resource.data.groupId + '_' + request.resource.data.subjectId + '_' + request.resource.data.teacherId)).data.active == true;
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
          (
            get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.counselorId == request.auth.uid ||
            get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.tempCounselorId == request.auth.uid
          ) &&
          (
            request.resource.data.groupId == resource.data.groupId ||
            get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.counselorId == request.auth.uid ||
            get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.tempCounselorId == request.auth.uid
          ) &&
          request.resource.data.teacherId is string &&
          exists(/databases/$(database)/documents/academic_assignments/$(request.resource.data.groupId + '_' + request.resource.data.subjectId + '_' + request.resource.data.teacherId)) &&
          get(/databases/$(database)/documents/academic_assignments/$(request.resource.data.groupId + '_' + request.resource.data.subjectId + '_' + request.resource.data.teacherId)).data.active == true
        )
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
          (
            get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.counselorId == request.auth.uid ||
            get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.tempCounselorId == request.auth.uid
          )
        )
      );
    }

    // Messages collection - read allowed for authenticated users, write restricted
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                   (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');
    }

    // Chat messages (1:1)
    match /chat_messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /badge_suggestions/{suggestionId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin']);
    }

    // Events collection - read for all roles, write restricted to directors and counselors
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                   (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador');
      allow delete: if request.auth != null &&
                    (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador');
    }

    // Dynamic attendance tokens generated by teachers for a specific group/class.
    match /attendance_tokens/{tokenId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'orientador', 'profesor'] ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['estudiante', 'alumno'] &&
          resource.data.groupId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId
        )
      );

      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor' &&
          request.resource.data.keys().hasAll(['subjectId', 'groupId', 'timetableId', 'code', 'date', 'expiresAt', 'teacherLocation']) &&
          request.resource.data.code is string &&
          request.resource.data.code.size() == 4 &&
          request.resource.data.date is string &&
          request.resource.data.teacherLocation is map &&
          request.resource.data.teacherLocation.latitude is number &&
          request.resource.data.teacherLocation.longitude is number &&
          (
            get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.teacherId == request.auth.uid ||
            (
              !get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.keys().hasAny(['teacherId']) &&
              get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.teacherId == request.auth.uid
            )
          ) &&
          get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.groupId == request.resource.data.groupId &&
          get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.subjectId == request.resource.data.subjectId &&
          (get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.teacherId == request.auth.uid || !get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.keys().hasAny(['teacherId'])) &&
          request.resource.data.expiresAt > request.time
        ) ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdByRole == 'orientador' &&
          request.resource.data.coverageId is string &&
          get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.substituteCounselorId == request.auth.uid &&
          get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.groupId == request.resource.data.groupId &&
          get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.status in ['scheduled', 'active'] &&
          request.time >= get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.startsAt &&
          request.time <= get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.endsAt &&
          request.resource.data.keys().hasAll(['subjectId', 'groupId', 'timetableId', 'code', 'date', 'expiresAt', 'coverageId', 'takeoverId', 'createdBy', 'createdByRole', 'teacherLocation']) &&
          request.resource.data.code is string &&
          request.resource.data.code.size() == 4 &&
          request.resource.data.date is string &&
          request.resource.data.teacherLocation is map &&
          request.resource.data.teacherLocation.latitude is number &&
          request.resource.data.teacherLocation.longitude is number &&
          get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.groupId == request.resource.data.groupId &&
          get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.subjectId == request.resource.data.subjectId &&
          exists(/databases/$(database)/documents/counselor_class_takeovers/$(request.resource.data.takeoverId)) &&
          request.resource.data.expiresAt > request.time
        )
      );

      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';
    }

    // Attendance is written by the student only through a valid teacher token.
    match /attendance/{attendanceId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'orientador', 'profesor'] ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['estudiante', 'alumno'] &&
          resource.data.studentId == request.auth.uid
        )
      );

      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'profesor'] ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['estudiante', 'alumno'] &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.present == true &&
          request.resource.data.keys().hasAll(['studentId', 'groupId', 'subjectId', 'timetableId', 'date', 'present', 'tokenId', 'studentLocation', 'distanceToTeacher']) &&
          request.resource.data.studentLocation is map &&
          request.resource.data.studentLocation.latitude is number &&
          request.resource.data.studentLocation.longitude is number &&
          request.resource.data.distanceToTeacher is number &&
          request.resource.data.distanceToTeacher <= 75 &&
          get(/databases/$(database)/documents/attendance_tokens/$(request.resource.data.tokenId)).data.teacherLocation is map &&
          get(/databases/$(database)/documents/attendance_tokens/$(request.resource.data.tokenId)).data.teacherLocation.latitude is number &&
          get(/databases/$(database)/documents/attendance_tokens/$(request.resource.data.tokenId)).data.teacherLocation.longitude is number &&
          request.resource.data.studentLocation.latitude >= get(/databases/$(database)/documents/attendance_tokens/$(request.resource.data.tokenId)).data.teacherLocation.latitude - 0.00068 &&
          request.resource.data.studentLocation.latitude <= get(/databases/$(database)/documents/attendance_tokens/$(request.resource.data.tokenId)).data.teacherLocation.latitude + 0.00068 &&
          request.resource.data.studentLocation.longitude >= get(/databases/$(database)/documents/attendance_tokens/$(request.resource.data.tokenId)).data.teacherLocation.longitude - 0.00072 &&
          request.resource.data.studentLocation.longitude <= get(/databases/$(database)/documents/attendance_tokens/$(request.resource.data.tokenId)).data.teacherLocation.longitude + 0.00072 &&
          request.resource.data.groupId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId &&
          get(/databases/$(database)/documents/attendance_tokens/$(request.resource.data.tokenId)).data.groupId == request.resource.data.groupId &&
          get(/databases/$(database)/documents/attendance_tokens/$(request.resource.data.tokenId)).data.subjectId == request.resource.data.subjectId &&
          get(/databases/$(database)/documents/attendance_tokens/$(request.resource.data.tokenId)).data.timetableId == request.resource.data.timetableId &&
          get(/databases/$(database)/documents/attendance_tokens/$(request.resource.data.tokenId)).data.expiresAt > request.time &&
          request.resource.data.date == get(/databases/$(database)/documents/attendance_tokens/$(request.resource.data.tokenId)).data.date
        )
      );

      allow update, delete: if request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'profesor'] ||
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
          request.resource.data.appealResolved == true &&
          request.resource.data.appealResolvedBy == request.auth.uid &&
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.counselorId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['present','source','recordedBy','recordedByRole','appealId','appealResolved','appealResolvedAt','appealResolvedBy','appealResolutionReason'])))
    }

    // Grades collection - read/write based on role
    match /grades/{gradeId} {
      allow read: if request.auth != null &&
                  (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' ||
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');
      allow write: if request.auth != null &&
                   (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');
    }

    // Activity Logs collection
    match /activity_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
                  (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador');
    }

    // General school presence: each authenticated user may register only
    // their own GPS observation. Director can review the whole school.
    match /school_presence_checks/{checkId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'userId', 'date', 'checkTime', 'role', 'inside',
          'distanceMeters', 'confidence', 'isMocked', 'source'
        ]) &&
        request.resource.data.checkTime in ['07:00', '07:05', '07:10', '07:15', '07:20'] &&
        request.resource.data.source == 'client-gps' &&
        (
          !request.resource.data.keys().hasAny(['groupId']) ||
          (
            request.resource.data.groupId is string &&
            (
              request.resource.data.role in ['estudiante', 'alumno'] &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.groupId == request.resource.data.groupId
            ) ||
            (
              request.resource.data.role == 'profesor' &&
              request.resource.data.keys().hasAny(['timetableId']) &&
              get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.teacherId == request.auth.uid &&
              get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.groupId == request.resource.data.groupId
            )
          )
        );

      allow read: if request.auth != null &&
        (
          request.auth.uid == resource.data.userId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin'] ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
            resource.data.keys().hasAny(['groupId']) &&
            (
              get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.counselorId == request.auth.uid ||
              get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.tempCounselorId == request.auth.uid
            )
          )
        );

      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin'];
    }

    // Temporary counselor coverage. It grants scoped operational access
    // without changing groups.counselorId.
    match /counselor_coverages/{coverageId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin'] ||
        resource.data.primaryCounselorId == request.auth.uid ||
        resource.data.substituteCounselorId == request.auth.uid
      );

      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
        request.resource.data.primaryCounselorId is string &&
        request.resource.data.substituteCounselorId == request.auth.uid &&
        request.resource.data.groupId is string &&
        get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.counselorId == request.resource.data.primaryCounselorId &&
        (
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.counselorId == request.resource.data.primaryCounselorId ||
          get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.tempCounselorId == request.resource.data.primaryCounselorId
        );

      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin'] ||
        (
          resource.data.substituteCounselorId == request.auth.uid &&
          resource.data.status == 'active' &&
          request.resource.data.groupId == resource.data.groupId &&
          request.resource.data.primaryCounselorId == resource.data.primaryCounselorId &&
          request.resource.data.substituteCounselorId == resource.data.substituteCounselorId
        )
      );
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin'];
    }

    // Registro formal de que el orientador sustituto tomó una clase porque el profesor
    // programado estaba ausente o no disponible. No modifica al profesor del horario.
    match /counselor_class_takeovers/{takeoverId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin'] ||
        resource.data.counselorId == request.auth.uid ||
        get(/databases/$(database)/documents/counselor_coverages/$(resource.data.coverageId)).data.primaryCounselorId == request.auth.uid
      );

      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
        request.resource.data.counselorId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'coverageId', 'groupId', 'timetableId', 'subjectId', 'teacherId',
          'counselorId', 'date', 'startTime', 'endTime', 'reason', 'createdAt'
        ]) &&
        request.resource.data.reason in ['teacher_absent', 'teacher_unavailable', 'other'] &&
        get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.substituteCounselorId == request.auth.uid &&
        get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.groupId == request.resource.data.groupId &&
        get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.status in ['scheduled', 'active'] &&
        request.time >= get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.startsAt &&
        request.time <= get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.endsAt &&
        get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.groupId == request.resource.data.groupId &&
        get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.subjectId == request.resource.data.subjectId &&
        (
          get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.teacherId == request.resource.data.teacherId ||
          (
            !get(/databases/$(database)/documents/timetables/$(request.resource.data.timetableId)).data.keys().hasAny(['teacherId']) &&
            get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.teacherId == request.resource.data.teacherId
          )
        ) &&
        request.resource.data.date == get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.date;

      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin'];
    }

    // Novedades registradas durante una cobertura temporal.
    // No modifican automáticamente asistencia; dejan constancia de lo ocurrido.
    match /counselor_incident_reports/{reportId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin'] ||
        get(/databases/$(database)/documents/counselor_coverages/$(resource.data.coverageId)).data.primaryCounselorId == request.auth.uid ||
        get(/databases/$(database)/documents/counselor_coverages/$(resource.data.coverageId)).data.substituteCounselorId == request.auth.uid
      );

      allow create: if request.auth != null &&
        request.resource.data.keys().hasAll([
          'coverageId', 'groupId', 'date', 'time', 'type', 'summary',
          'createdBy', 'createdByName', 'createdByRole'
        ]) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
            request.resource.data.createdBy == request.auth.uid &&
            (
              get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.primaryCounselorId == request.auth.uid ||
              get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.substituteCounselorId == request.auth.uid
            ) &&
            get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.groupId == request.resource.data.groupId &&
            get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.status in ['scheduled', 'active'] &&
            request.time >= get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.startsAt &&
            request.time <= get(/databases/$(database)/documents/counselor_coverages/$(request.resource.data.coverageId)).data.endsAt
          )
        );

      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin'];
    }

    // Substitution requests remain separate from the actual temporary coverage.
    match /substitution_requests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.fromCounselorId == request.auth.uid ||
        resource.data.toCounselorId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin']
      );

      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&
        request.resource.data.fromCounselorId == request.auth.uid &&
        request.resource.data.toCounselorId != request.auth.uid &&
        request.resource.data.groupIds is list && request.resource.data.groupIds.size() > 0 &&
        request.resource.data.date is string &&
        request.resource.data.startTime is string && request.resource.data.endTime is string;

      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['director', 'admin'] ||
        resource.data.toCounselorId == request.auth.uid
      );
    }

    // Default rule - restrictive for all other collections
    match /{document=**} {
      allow read, write: if false; // Default: no access
    }
  }
    match /attendance_appeals/{appealId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.counselorId == request.auth.uid ||
        get(/databases/\$(database)/documents/users/\$(request.auth.uid)).data.role == 'director'
      );
      allow create: if request.auth != null &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.originalPresent == false &&
        request.resource.data.status == 'pending' &&
        get(/databases/\$(database)/documents/attendance/\$(request.resource.data.attendanceId)).data.studentId == request.auth.uid &&
        get(/databases/\$(database)/documents/attendance/\$(request.resource.data.attendanceId)).data.present == false;
      allow update: if request.auth != null && (
        get(/databases/\$(database)/documents/users/\$(request.auth.uid)).data.role == 'director' ||
        (request.auth.uid == resource.data.teacherId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherConfirmedBy','teacherConfirmedAt','status','counselorConfirmedBy','counselorConfirmedAt','resolution','resolvedBy','resolvedAt','resolutionReason'])) ||
        (request.auth.uid == resource.data.counselorId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counselorConfirmedBy','counselorConfirmedAt','teacherConfirmedBy','teacherConfirmedAt','status','resolution','resolvedBy','resolvedAt','resolutionReason']))
      );
      allow delete: if request.auth != null &&
        get(/databases/\$(database)/documents/users/\$(request.auth.uid)).data.role == 'director';
    }

}
